{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/label-sea/components.schema.json",
  "title": "label-sea component file",
  "type": "object",
  "additionalProperties": false,
  "required": ["components"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "connectors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "additionalProperties": { "$ref": "#/$defs/connector" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "enum": [
            "generator",
            "consumer",
            "distributor",
            "erzeuger",
            "verbraucher",
            "verteiler"
          ]
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apparent_kva": { "type": "number", "minimum": 0 },
            "active_kw": { "type": "number", "minimum": 0 }
          }
        },
        "feed_in": {
          "type": "boolean"
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portReference" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portReference" }
        }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ampere"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "ampere": {
          "type": "integer",
          "minimum": 1,
          "maximum": 125
        },
        "style": {
          "type": "string",
          "enum": ["solid", "dashed", "fine-dashed"]
        }
      }
    },
    "inlinePort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ampere"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "ampere": {
          "type": "integer",
          "minimum": 1,
          "maximum": 125
        },
        "style": {
          "type": "string",
          "enum": ["solid", "dashed", "fine-dashed"]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "portRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "portReference": {
      "oneOf": [
        { "$ref": "#/$defs/inlinePort" },
        { "$ref": "#/$defs/portRef" }
      ]
    }
  }
}